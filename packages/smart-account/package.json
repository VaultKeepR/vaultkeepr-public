    "viem": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "ox": "^0.14.34",
    "permissionless": "^0.3.5",
    "react": "19.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "viem": "^2.48.4",
    "vitest": "^2.1.5"
  },
  "files": [
    "dist"
  ]
