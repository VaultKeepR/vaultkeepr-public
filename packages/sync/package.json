{
  "name": "@vaultkeepr/sync",
  "version": "0.1.3",
  "description": "CRDT-based vault synchronization engine \u2014 Automerge-powered conflict-free merge for VaultKeepR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaultKeepR/vaultkeepr-public.git",
    "directory": "packages/sync"
  },
  "license": "MIT",
  "keywords": [
    "crdt",
    "automerge",
    "sync",
    "vault",
    "conflict-free",
    "offline",
    "vaultkeepr"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint src/",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.6",
    "@vaultkeepr/core": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://vaultkeepr.xyz",
  "bugs": {
    "url": "https://github.com/VaultKeepR/vaultkeepr-public/issues"
  }
}
