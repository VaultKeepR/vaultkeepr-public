{
  "name": "@vaultkeepr/core",
  "version": "0.1.3",
  "description": "TypeScript vault crypto: XChaCha20-Poly1305, Argon2id, wallet ECIES envelopes, TOTP, imports \u2014 VaultKeepR SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaultKeepR/vaultkeepr-public.git",
    "directory": "packages/core"
  },
  "homepage": "https://vaultkeepr.xyz",
  "bugs": {
    "url": "https://github.com/VaultKeepR/vaultkeepr-public/issues"
  },
  "license": "MIT",
  "keywords": [
    "vault",
    "encryption",
    "argon2",
    "xchacha20",
    "totp",
    "e2ee",
    "vaultkeepr"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint src/",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@vaultkeepr/logger": "workspace:*",
    "ethers": "^6.13.0",
    "fflate": "^0.8.3",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ]
}
