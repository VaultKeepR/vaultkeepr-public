{
  "name": "@vault-keeper/core",
  "version": "0.1.0",
  "description": "TypeScript vault crypto: XChaCha20-Poly1305, Argon2id, wallet ECIES envelopes, TOTP, imports — VaultKeepR SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/VaultKeepR/vaultkeepr-core.git"
  },
  "homepage": "https://github.com/VaultKeepR/vaultkeepr-core#readme",
  "bugs": {
    "url": "https://github.com/VaultKeepR/vaultkeepr-core/issues"
  },
  "license": "MIT",
  "keywords": [
    "vault",
    "encryption",
    "argon2",
    "xchacha20",
    "totp",
    "e2ee",
    "vaultkeepr"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@vault-keeper/logger": "0.1.0",
    "ethers": "^6.13.0",
    "fflate": "^0.8.3",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "files": [
    "dist"
  ]
}
