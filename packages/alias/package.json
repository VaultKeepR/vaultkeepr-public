{
  "name": "@vault-keeper/alias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/forward.ts src/db.ts src/config.ts src/generate.ts src/scripts/migrate.ts --format esm --dts",
    "test": "vitest run",
    "forward": "node dist/forward.js",
    "db:migrate": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "mailparser": "^3.7.0",
    "nodemailer": "^10.0.1",
    "openpgp": "^6.3.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "bin": {
    "vaultkeeper-forward": "./dist/forward.js"
  },
  "license": "MIT"
}
