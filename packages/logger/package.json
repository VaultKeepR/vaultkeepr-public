{
  "name": "@vaultkeepr/logger",
  "version": "0.1.2",
  "private": false,
  "description": "VaultKeepR secure logger with automatic CID/address redaction and dev-only gating",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaultKeepR/vaultkeepr-public.git",
    "directory": "packages/logger"
  },
  "homepage": "https://vaultkeepr.xyz",
  "bugs": {
    "url": "https://github.com/VaultKeepR/vaultkeepr-public/issues"
  }
}
